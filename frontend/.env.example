# 前端配置示例：复制为 frontend/.env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
# 所有变量必须以 VITE_ 开头才会被 Vite 注入；修改后需重启 dev 服务生效

# 前端开发服务器端口（Vite dev server）
VITE_DEV_PORT=3000

# 后端服务地址：开发服务器把 /api 与 /ws 代理到这里，需与 backend/.env 的 BACKEND_PORT 对应
VITE_BACKEND_ORIGIN=http://localhost:8000

# 浏览器直连后端的地址：默认留空 = 走同源（开发时经上面的代理转发，生产时由反向代理转发）
# 仅当前后端不同源、不走代理时才需要填，例如：
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws
VITE_API_BASE_URL=
VITE_WS_URL=
