# ============================================================
# 数字孪生工厂 - 后端环境配置示例
# 复制为 .env 后按需修改；.env 不入库，仅本机生效
# 与 frontend/.env.example 使用同一套口径（HOST/PORT/路径）
# ============================================================

# 后端监听地址与端口（uvicorn 绑定）
# 仅本机访问用 127.0.0.1；局域网/容器内联调用 0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 允许跨域访问的前端来源，逗号分隔
# 本地开发默认放行 Vite dev server（端口由 frontend/.env 的 DEV_SERVER_PORT 决定）
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 数据通道路径（需与前端 VITE_API_BASE / VITE_WS_PATH、Vite 代理保持一致）
API_PREFIX=/api
WS_PATH=/ws
